# Servidor
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
# Sustituye TU_PASSWORD por la contraseña del usuario postgres de tu computadora.
DATABASE_URL="postgresql://postgres:password@localhost:5432/sistema_inventario?schema=public"

# JWT: usa una cadena larga y aleatoria de al menos 32 caracteres.
JWT_SECRET="12345678912345678912345678912346789"
JWT_EXPIRES_IN=8h

# Protección básica del endpoint de login
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Usuario inicial de prueba creado por npm run seed
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@lwater.local"
SEED_ADMIN_PASSWORD="password123*"
BCRYPT_ROUNDS=12
