// PROPOSAL ONLY. The active schema remains backend/prisma/schema.prisma.
// SQL CHECK constraints, expression indexes and triggers live in the SQL proposal.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id          BigInt    @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(150)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  usuarios    Usuario[]

  @@map("rol")
}

model Usuario {
  id            BigInt    @id @default(autoincrement())
  nombre        String    @db.VarChar(120)
  correo        String    @unique @db.VarChar(180)
  passwordHash  String    @map("contraseña") @db.VarChar(255)
  rolId         BigInt    @map("rol_id")
  activo        Boolean   @default(true)
  ultimoAcceso  DateTime? @map("ultimo_acceso") @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  rol           Rol       @relation(fields: [rolId], references: [id], onDelete: Restrict)
  bodegas       Bodega[]

  @@map("usuarios")
}

model Persona {
  id             BigInt    @id @default(autoincrement())
  nombres        String    @db.VarChar(120)
  apellidos      String    @db.VarChar(120)
  nit            String?   @db.VarChar(25)
  telefono       String?   @db.VarChar(40)
  correo         String?   @db.VarChar(180)
  direccion      String?
  municipio      String?   @db.VarChar(160)
  pais           String?   @db.VarChar(100)
  nombreContacto String?   @map("nombre_contacto") @db.VarChar(200)
  codigoPostal   String?   @map("codigo_postal") @db.VarChar(20)
  observaciones  String?
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tercero        Tercero?
  empresas       Empresa[] @relation("PropietarioEmpresa")

  @@map("personas")
}

model Empresa {
  id                   BigInt    @id @default(autoincrement())
  // INDIVIDUAL: nombre de empresa. JURIDICA: nombre comercial.
  nombreComercial      String    @map("nombre_comercial") @db.VarChar(200)
  // INDIVIDUAL: nombre social (meaning pending). JURIDICA: razon social.
  razonSocial          String?   @map("razon_social") @db.VarChar(250)
  tipoEmpresa          String    @map("tipo_empresa") @db.VarChar(12)
  formaJuridica        String?   @map("forma_juridica") @db.VarChar(100)
  propietarioPersonaId BigInt?   @map("propietario_persona_id")
  nit                  String?   @db.VarChar(25)
  telefono             String?   @db.VarChar(40)
  correo               String?   @db.VarChar(180)
  direccion            String?
  municipio            String?   @db.VarChar(160)
  pais                 String?   @db.VarChar(100)
  nombreContacto       String?   @map("nombre_contacto") @db.VarChar(200)
  codigoPostal         String?   @map("codigo_postal") @db.VarChar(20)
  observaciones        String?
  activo               Boolean   @default(true)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  propietario          Persona?  @relation("PropietarioEmpresa", fields: [propietarioPersonaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tercero              Tercero?

  @@index([propietarioPersonaId], map: "ix_empresas_propietario")
  @@map("empresas")
}

model Tercero {
  id            BigInt       @id @default(autoincrement())
  // SQL enforces exactly one identity, never both and never neither.
  personaId     BigInt?      @unique @map("persona_id")
  empresaId     BigInt?      @unique @map("empresa_id")
  observaciones String?
  activo        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  persona       Persona?     @relation(fields: [personaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  empresa       Empresa?     @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roles         TerceroRol[]

  @@map("terceros")
}

model TerceroRol {
  terceroId          BigInt                 @map("tercero_id")
  rol                String                 @db.VarChar(15)
  // PROVEEDOR is a role of Tercero, not another identity/table.
  metodoPago         String?                @map("metodo_pago") @db.VarChar(20)
  diasCredito        Int?                   @map("dias_credito")
  beneficiarioCheque String?                @map("beneficiario_cheque") @db.VarChar(250)
  activo             Boolean                @default(true)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  tercero            Tercero                @relation(fields: [terceroId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cuentaBancaria     CuentaBancariaTercero?

  @@id([terceroId, rol])
  @@map("tercero_roles")
}

model CuentaBancariaTercero {
  // Optional 1:1 extension, not a duplicated supplier entity.
  terceroId    BigInt     @map("tercero_id")
  rol          String     @default("PROVEEDOR") @db.VarChar(15)
  banco        String     @db.VarChar(160)
  nombreCuenta String     @map("nombre_cuenta") @db.VarChar(250)
  numeroCuenta String     @map("numero_cuenta") @db.VarChar(80)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  terceroRol   TerceroRol @relation(fields: [terceroId, rol], references: [terceroId, rol], onDelete: Restrict, onUpdate: Restrict)

  @@id([terceroId, rol])
  @@map("cuentas_bancarias_tercero")
}

model Categoria {
  id                BigInt         @id @default(autoincrement())
  codigo            String?        @unique @db.VarChar(40)
  nombre            String         @unique @db.VarChar(200)
  descripcion       String?
  pendienteRevision Boolean        @default(false) @map("pendiente_revision")
  activo            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  subcategorias     Subcategoria[]
  productos         Producto[]

  @@map("categorias")
}

model Subcategoria {
  id            BigInt     @id @default(autoincrement())
  categoriaId   BigInt     @map("categoria_id")
  codigo        String?    @db.VarChar(40)
  nombre        String     @db.VarChar(200)
  descripcion   String?
  activo        Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  categoria     Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productos     Producto[]

  @@unique([id, categoriaId], map: "uq_subcategorias_id_categoria")
  @@unique([categoriaId, nombre], map: "uq_subcategorias_categoria_nombre")
  @@unique([categoriaId, codigo], map: "uq_subcategorias_categoria_codigo")
  @@map("subcategorias")
}

model Marca {
  id        BigInt     @id @default(autoincrement())
  nombre    String     @unique @db.VarChar(160)
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  productos Producto[]

  @@map("marcas")
}

model UnidadMedida {
  id                BigInt     @id @default(autoincrement())
  codigo            String     @unique @db.VarChar(30)
  nombre            String     @unique @db.VarChar(100)
  simbolo           String?    @db.VarChar(20)
  permiteFracciones Boolean    @default(false) @map("permite_fracciones")
  activo            Boolean    @default(true)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  productos         Producto[]

  @@map("unidades_medida")
}

model TipoInventario {
  id          BigInt     @id @default(autoincrement())
  codigo      String     @unique @db.VarChar(40)
  nombre      String     @unique @db.VarChar(160)
  descripcion String?
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  productos   Producto[]

  @@map("tipos_inventario")
}

model ClaseCoa {
  // Retains the independent accounting classification already in the SQL.
  id          BigInt     @id @default(autoincrement())
  codigo      String     @unique @db.VarChar(50)
  nombre      String?    @db.VarChar(200)
  descripcion String?
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  productos   Producto[]

  @@map("clases_coa")
}

model Producto {
  id                  BigInt          @id @default(autoincrement())
  codigo              String          @unique @db.VarChar(80)
  nombre              String          @db.VarChar(255)
  descripcion         String?
  categoriaId         BigInt          @map("categoria_id")
  subcategoriaId      BigInt?         @map("subcategoria_id")
  unidadMedidaId      BigInt?         @map("unidad_medida_id")
  marcaId             BigInt?         @map("marca_id")
  tipoInventarioId    BigInt?         @map("tipo_inventario_id")
  claseCoaId          BigInt?         @map("clase_coa_id")
  esPerecedero        Boolean?        @map("es_perecedero")
  requiereVencimiento Boolean?        @map("requiere_vencimiento")
  // Threshold only. No initial stock, available balance or current cost here.
  stockMinimo         Decimal?        @map("stock_minimo") @db.Decimal(18, 3)
  fuenteImportacion   String?         @map("fuente_importacion") @db.VarChar(160)
  pendienteRevision   Boolean         @default(true) @map("pendiente_revision")
  observaciones       String?
  activo              Boolean         @default(true)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  categoria           Categoria       @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subcategoria        Subcategoria?   @relation(fields: [subcategoriaId, categoriaId], references: [id, categoriaId], onDelete: Restrict, onUpdate: Restrict, map: "fk_productos_subcategoria_categoria")
  unidadMedida        UnidadMedida?   @relation(fields: [unidadMedidaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  marca               Marca?          @relation(fields: [marcaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tipoInventario      TipoInventario? @relation(fields: [tipoInventarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  claseCoa            ClaseCoa?       @relation(fields: [claseCoaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([categoriaId], map: "ix_productos_categoria")
  @@index([subcategoriaId], map: "ix_productos_subcategoria")
  @@index([unidadMedidaId], map: "ix_productos_unidad")
  @@index([marcaId], map: "ix_productos_marca")
  @@index([tipoInventarioId], map: "ix_productos_tipo_inventario")
  @@index([claseCoaId], map: "ix_productos_clase_coa")
  @@map("productos")
}

model Bodega {
  id                   BigInt    @id @default(autoincrement())
  codigo               String    @unique @db.VarChar(40)
  nombre               String    @db.VarChar(160)
  descripcion          String?
  direccion            String?
  responsableUsuarioId BigInt?   @map("responsable_usuario_id")
  activo               Boolean   @default(true)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  responsable          Usuario?  @relation(fields: [responsableUsuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([responsableUsuarioId], map: "ix_bodegas_responsable")
  @@map("bodegas")
}
